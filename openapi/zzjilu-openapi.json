  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "description": "通用响应结构",
        "properties": {
          "resultCode": { "type": "string", "description": "结果编码，\"0\" 表示成功" },
          "resultMsg": { "type": "string", "description": "结果消息" },
          "resultObject": { "description": "响应数据（类型因接口而异）" },
          "stack": { "type": "string", "description": "错误堆栈（通常为空）" },
          "errorInfos": { "type": "array", "items": {}, "nullable": true },
          "guidance": { "nullable": true }
        }
      },
      "PageInfo": {
        "type": "object",
        "description": "分页信息（基于 PageHelper）",
        "properties": {
          "total": { "type": "string", "description": "总记录数（字符串类型）" },
          "list": { "type": "array", "items": {} },
          "pageNum": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "size": { "type": "integer", "description": "当前页实际记录数" },
          "pages": { "type": "integer", "description": "总页数" },
          "isFirstPage": { "type": "boolean" },
          "isLastPage": { "type": "boolean" },
          "hasPreviousPage": { "type": "boolean" },
          "hasNextPage": { "type": "boolean" }
        }
      },
      "NoteListItem": {
        "type": "object",
        "description": "笔记列表项",
        "properties": {
          "id": { "type": "string", "description": "笔记 ID" },
          "title": { "type": "string" },
          "abstract": { "type": "string", "nullable": true },
          "summary": { "type": "string", "nullable": true },
          "note_type": { "type": "string", "enum": ["voice", "text", "image", "document", "link"] },
          "note_state": { "type": "string", "enum": ["completed", "pending", "recognizing", "analyzing", "failed"] },
          "create_time": { "type": "string" },
          "scene_name": { "type": "string", "nullable": true },
          "creator_id": { "type": "string" }
        }
      },
      "SceneItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "场景 ID" },
          "scene_name": { "type": "string" },
          "scene_desc": { "type": "string", "nullable": true },
          "scene_require": { "type": "string", "nullable": true, "description": "场景提示词" }
        }
      },
      "KnowledgeItem": {
        "type": "object",
        "description": "笔记集项",
        "properties": {
          "knowledgeId": { "type": "string" },
          "knowledgeName": { "type": "string" },
          "knowledgeDetail": { "type": "string" },
          "knowledgeAttribute": { "type": "string", "description": "private/restricted/public" },
          "knowledgeType": { "type": "string", "description": "person/team" },
          "contentTotal": { "type": "integer" },
          "userName": { "type": "string" }
        }
      },
      "KnowledgeCardItem": {
        "type": "object",
        "description": "知识卡笔记",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "summary": { "type": "string", "nullable": true },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string", "description": "问题" },
                "answer": { "type": "string", "description": "回答" },
                "remarks": { "type": "string", "description": "详细解读（Markdown）" }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API Key（无需 Bearer 前缀）"
      }
    }
  },
  "security": [{ "apiKeyAuth": [] }]
}
